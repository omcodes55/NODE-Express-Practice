<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="p-10">
      <h1 class=text-xl font-bold m-6">Dashboard</h1>
      <form action="/logout" method="get">
        <button
          type="submit"
          class="p-10 bg-red-600 text-white py-2 rounded-lg font-semibold hover:bg-red-700 transition duration-300"
        >
          Logout
        </button>
      </form>
    </div>
  </body>
</html>
