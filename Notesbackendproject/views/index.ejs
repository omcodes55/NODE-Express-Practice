<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Notes</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-stone-100">

<div class="max-w-6xl mx-auto py-10 px-6">

    <!-- Heading -->
    <div class="mb-10">
        <h1 class="text-4xl font-bold text-emerald-700">
            Notes
        </h1>
        <p class="text-gray-600 mt-2">
            Write your thoughts
        </p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-2xl shadow-md p-6 mb-10">

        <h2 class="text-xl font-semibold text-gray-800 mb-5">
            Create a New Note
        </h2>

        <form action="/create" method="POST">

            <input 
                type="text"
                name="title"
                placeholder="Note Title"
                required
                class="w-full border border-gray-300 rounded-xl px-4 py-3 mb-4 outline-none focus:ring-2 focus:ring-emerald-500"
            >

            <textarea
                name="description"
                rows="6"
                placeholder="Write something..."
                required
                class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none resize-none focus:ring-2 focus:ring-emerald-500"
            ></textarea>

            <button
                class="mt-5 bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl transition">
                Save Note
            </button>

        </form>

    </div>

    <!-- Notes -->
    <h2 class="text-2xl font-bold text-gray-800 mb-5">
        Your Notes
    </h2>

    <% if(files.length === 0){ %>

        <div class="bg-white rounded-xl shadow p-8 text-center">
            <h3 class="text-gray-500">
                No notes yet.
            </h3>
        </div>

    <% } else { %>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

            <% files.forEach(function(file){ %>

                <div class="bg-white rounded-2xl shadow hover:shadow-lg transition p-5">

                    <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center mb-4">
                        📄
                    </div>

                    <h3 class="text-xl font-semibold text-gray-800 break-words">
                        <%= file.replace(".txt","") %>
                    </h3>

                    <p class="text-gray-500 text-sm mt-2">
                        Stored as a text file.
                    </p>
                    

                    <div class="justify-between flex gap-50 mt-4 ">
                        <a
                        href="/file/<%= file %>"
                        class="inline-block  text-emerald-600 font-medium hover:underline"
                    >
                        Read Note
                    </a>
                    <a
                        href="/edit/<%= file %>"
                        class="inline-block text-emerald-600 font-medium transition-transform duration-300 ease-in-out hover:scale-110 border-2 border-emerald-600 px-2"
                    >
                        Edit
                    </a>

                     <a
                        href="/delete/<%= file %>"
                        class="inline-block text-red-600 font-medium transition-transform duration-300 ease-in-out hover:scale-110 border-2 border-red-600 px-2"
                    >
                        Delete
                    </a>
                    </div>
                    

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

</body>
</html>