<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Connect to PM</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="bg-slate-50 min-h-screen flex flex-col items-center justify-center font-sans antialiased"
  >

    <!-- Main Card -->
    <div
      class="bg-white border border-slate-100 p-8 rounded-2xl shadow-xl text-center max-w-md w-full mx-4"
    >

      <!-- Heading -->
      <h1
        class="text-4xl font-black text-orange-600 tracking-tight mb-3"
      >
        Hello Friends...!!
      </h1>

      <!-- Subtitle -->
      <p class="text-slate-500 font-semibold text-lg italic mb-8">
        - Mr. Narendra Modi
      </p>

      <!-- Form -->
      <form action="/create" method="post" class="space-y-4">

        <!-- Name Input -->
        <input
          type="text"
          name="name"
          placeholder="Enter Name"
          required
          class="w-full px-4 py-3 border border-slate-300 rounded-lg
                 outline-none
                 focus:border-orange-500
                 focus:ring-2
                 focus:ring-orange-200
                 transition duration-200"
        />

        <!-- Email Input -->
        <input
          type="email"
          name="email"
          placeholder="Enter Email"
          required
          class="w-full px-4 py-3 border border-slate-300 rounded-lg
                 outline-none
                 focus:border-orange-500
                 focus:ring-2
                 focus:ring-orange-200
                 transition duration-200"
        />

        <!-- Image URL Input -->
        <input
          type="text"
          name="image"
          placeholder="Enter Image URL"
          required
          class="w-full px-4 py-3 border border-slate-300 rounded-lg
                 outline-none
                 focus:border-orange-500
                 focus:ring-2
                 focus:ring-orange-200
                 transition duration-200"
        />

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full bg-orange-600 text-white font-bold py-3 rounded-lg
                 hover:bg-orange-700
                 active:scale-95
                 transition duration-200"
        >
          Submit
        </button>

      </form>

      <!-- Bottom Message -->
      <div class="mt-6 pt-5 border-t border-slate-200">

        <p class="text-sm text-slate-500">
          All data submitted to
        </p>

        <p class="text-orange-600 font-bold text-lg mt-1">
          Mr. Narendra Modi 😄
        </p>

      </div>

    </div>

  </body>
</html>