<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>PM Connect - USERS</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-slate-100 min-h-screen p-4">

    <!-- Main Container -->
    <div class="max-w-full mx-5">

      <!-- Heading -->
      <h1 class="text-4xl font-bold text-slate-800 mb-10 mt-5">
        All Users
      </h1>

      <!-- Users Container -->
      <div class="users grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-6">

        <!-- Check if users are available -->
        <% if (users.length === 0) { %>

          <!-- No Users Message -->
          <div class="col-span-full text-center py-20">
            <h2 class="text-2xl font-semibold text-slate-500">
              No Users Found
            </h2>

            <p class="text-slate-400 mt-2">
              There are currently no users available.
            </p>
          </div>

        <% } else { %>

          <!-- Loop Through Users -->
          <% users.forEach(function(user) { %>

            <!-- User Card -->
            <div
              class="bg-white border border-slate-200 rounded-2xl shadow-lg p-6 text-center hover:shadow-xl transition duration-300"
            >

              <!-- Profile Image -->
              <div
                class="w-24 h-24 bg-slate-200 rounded-full mx-auto mb-4 flex items-center justify-center text-slate-500 font-semibold overflow-hidden"
              >
                <img
                  class="w-full h-full object-cover"
                  src="<%= user.image %>"
                  alt="Profile pic"
                />
              </div>

              <!-- Name -->
              <h3 class="text-xl font-bold text-slate-800 mb-1">
                <%= user.name %>
              </h3>

              <!-- Email -->
              <h5 class="text-sm text-slate-500 mb-6">
                <%= user.email %>
              </h5>

              <!-- Buttons -->
              <div class="flex gap-3 justify-center">

                <!-- Edit Button -->
                <a
                  href="/edit/<%= user._id %>"
                  class="edit bg-blue-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-600 active:scale-95 transition duration-200"
                >
                  Edit
                </a>

                <!-- Delete Button -->
                <a
                  href="/delete/<%= user._id %>"
                  class="delete bg-red-500 text-white px-5 py-2 rounded-lg font-semibold hover:bg-red-600 active:scale-95 transition duration-200"
                >
                  Delete
                </a>

              </div>

            </div>

          <% }) %>

        <% } %>

      </div>

    </div>

  </body>
</html>