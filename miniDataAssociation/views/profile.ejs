<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Profile</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

  <nav class="bg-gray-900 text-white px-6 py-4">

    <div class="max-w-2xl mx-auto flex justify-between items-center">

      <h2 class="text-xl font-semibold">
        Mini Social Media
      </h2>

      <form action="/logout" method="get">

        <button type="submit" class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded-lg text-sm transition">
          Logout
        </button>

      </form>

    </div>

  </nav>


  <main class="max-w-2xl mx-auto px-4 py-8">

    <div class="bg-white rounded-xl shadow p-6 mb-6">

      <h1 class="text-2xl font-bold text-gray-800">
        Hello, <%= user.name %> 👋
      </h1>

      <p class="text-gray-500 mt-1">
        @<%= user.username %>
      </p>

      <div class="mt-4 flex gap-6 text-sm text-gray-600">


      </div>

    </div>


    <div class="bg-white rounded-xl shadow p-6">

      <h2 class="text-xl font-semibold text-gray-800 mb-2">
        Create New Post
      </h2>

      <p class="text-gray-500 mb-5">
        Share what's on your mind.
      </p>


      <form action="/post" method="POST">

        <textarea name="content" rows="5" placeholder="What's on your mind?" required
          class="w-full border border-gray-300 rounded-lg p-3 outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>

        <button type="submit" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg transition">
          Create New Post
        </button>

      </form>


      <div class="mt-8">

        <div class="flex items-center justify-between mb-4">

          <h3 class="text-xl font-semibold text-gray-800">
            Posts
          </h3>

          <span class="text-sm text-gray-500">
            <%= user.posts.length %> posts
          </span>

        </div>


        <div class="space-y-4">

          <% if (user.posts.length> 0) { %>

            <% user.posts.forEach(function(post) { %>

              <div class="border border-gray-200 rounded-xl p-5 bg-gray-50 hover:shadow-md transition">

                <div class="flex items-center justify-between mb-3">

                  <div class="flex items-center gap-3">

                    <div>

                      <p class="text-lg text-blue-400">
                        @<%= user.username %>
                      </p>

                    </div>

                  </div>


                  <span class="text-xs text-gray-400">

                    <% if (post.date) { %>
                      <%= post.date.toLocaleDateString() %>
                        <% } else { %>
                          Just now
                          <% } %>

                  </span>

                </div>


                <p class="text-gray-700 leading-relaxed mb-4">
                  <%= post.content %>
                </p>


                <div class="flex items-center justify-between">

                  <div class="flex items-center gap-2">



                    <button type="submit"
                      class="text-lg text-blue-600 hover:text-blue-800 hover:bg-blue-100 hover:scale-110 active:scale-95 px-3 py-2 rounded-full transition-all duration-200">
                      👍 Like
                    </button>

                  </div>

                </div>

              </div>

              <% }) %>

                <% } else { %>

                  <div class="text-center py-10 border border-dashed border-gray-300 rounded-xl">

                    <div class="text-4xl mb-3">
                      📝
                    </div>

                    <h4 class="font-semibold text-gray-700">
                      No posts yet
                    </h4>

                    <p class="text-sm text-gray-400 mt-1">
                      Create your first post above.
                    </p>

                  </div>

                  <% } %>

        </div>

      </div>

    </div>

  </main>

</body>

</html>